# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/stuttercare

# Long random string (32+ chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) allowed to call the API, comma separated
CLIENT_URL=http://localhost:5173

# --- Email (OTP codes) ---
# BEST for hosting (works on Render free, which blocks SMTP): Brevo API key from brevo.com -> SMTP & API -> API keys.
# MAIL_FROM must use a sender address you verified in Brevo.
BREVO_API_KEY=
# or: RESEND_API_KEY=
# Without SMTP_HOST, codes are printed in the server console (development only).
# Gmail: enable 2-Step Verification, create an "App password", then:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=StutterCare AI <your.address@gmail.com>
OTP_TTL_MIN=10

# Days of free Premium for every new verified account (0 = no trial)
TRIAL_DAYS=7

# Only for seedAdmin.js
# ADMIN_EMAIL=admin@stuttercare.com
# ADMIN_PASSWORD=

# Leave unset locally. In production leave empty. Only set if Atlas fails to resolve on your network.
# DNS_SERVERS=8.8.8.8,1.1.1.1
